# ---------- Server ----------
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000

# ---------- PostgreSQL ----------
# Local (docker compose up -d db):
DATABASE_URL=postgresql://am_user:am_secret@localhost:5432/am_management?schema=public
# Managed providers (Neon / Supabase / RDS / Railway): set true
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Only for the one-off legacy import (npm run migrate:mysql-to-pg)
MYSQL_URL=

# ---------- Auth ----------
JWT_ACCESS_SECRETE=change-me-access
JWT_REFRESH_SECRETE=change-me-refresh
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=

# ---------- Seed (npm run db:seed) ----------
SEED_ADMIN_EMAIL=admin@ammanagement.com.my
SEED_ADMIN_PASSWORD=ChangeMe#2026
SEED_ADMIN_NAME=AM Administrator

# ---------- Media ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- SMTP (password reset) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AM Management Group <no-reply@ammanagement.com.my>"
SMTP_SECURE=false
